{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wristband Tool",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Scan Only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--scan"],
      "console": "integratedTerminal"
    },
    {
      "name": "Full Dump",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--dump", "--address", "AA:BB:CC:DD:EE:FF"],
      "console": "integratedTerminal"
    }
  ]
}
